city.maark.ru {
    handle /city-weather {
        @notWeatherRead not method GET
        respond @notWeatherRead "Method not allowed" 405
        rewrite * /v1/forecast
        reverse_proxy https://api.open-meteo.com {
            header_up Host api.open-meteo.com
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up -Forwarded
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
            transport http {
                dial_timeout 3s
                response_header_timeout 6s
            }
        }
    }

    handle /city-search {
        @notSearchRead not method GET
        respond @notSearchRead "Method not allowed" 405
        rewrite * /v1/search
        reverse_proxy https://geocoding-api.open-meteo.com {
            header_up Host geocoding-api.open-meteo.com
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up -Forwarded
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
            transport http {
                dial_timeout 3s
                response_header_timeout 6s
            }
        }
    }

    handle {
    root * /srv/site/current
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob: https://listen.181fm.com https://channels.fluxfm.de https://streams.fluxfm.de https://stream-router.radiosphere.io https://*.streams.radiosphere.io https://*.streamabc.net; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
        Strict-Transport-Security "max-age=31536000"
        Cache-Control "no-cache"
        -Server
    }

    respond /healthz "ok" 200
    file_server
    }
}
