[Unit]
Description=SilentCity shared Moscow weather snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=silentcity-weather
Group=silentcity-weather
ExecStart=/usr/bin/python3 /opt/silentcity/scripts/update-weather.py --output /opt/silentcity/site/weather/current.json
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/silentcity/site/weather
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=64M
CPUQuota=10%

